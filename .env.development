# Local development defaults. Safe to commit: these only work against the
# Docker database from docker-compose.yml. Real keys go in .env.local; the
# hosted database values live only in Vercel, never in .env.local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/kora_test
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5434/kora_test
