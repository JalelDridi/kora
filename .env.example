# Copy to .env.local and fill in. Never commit real values. Leave the two
# database lines out of .env.local: local runs use the Docker database from
# .env.development, and the hosted database values live only in Vercel.

# Postgres (Neon pooled connection string in production, Docker locally)
DATABASE_URL=
# Direct (unpooled) connection, used for migrations
DATABASE_URL_UNPOOLED=

# The data sync (pnpm data:sync) writes only to a local database, except in
# a Vercel build (production or preview). Set to 1 to allow a hosted
# database from anywhere else, on purpose and for one command only. Leave it
# empty here and in .env.local.
KORA_SYNC_ALLOW_REMOTE=

# Chkoun?'s secret seed (decision D-S2-2): it draws the calendar of daily
# footballers and, from Task 8, signs the game's tokens. Required in Vercel
# for Production and Preview, with a different value in each: the build
# fails without it ("top up the Chkoun? calendar"). Make one on your own PC
# and paste it into Vercel only, never here, in .env.local or in a chat:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never change it after launch. Tests use a fixed test value of their own.
CHKOUN_SEED=

# Upstash Redis (leaderboards, rate limits). Features that need it are off
# when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: error tracking. Nothing is sent when this is empty.
SENTRY_DSN=

# Optional: PostHog, cookieless. Nothing is loaded when the key is empty.
# The key is public by design (it is sent to every browser).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: the password for the hidden /admin pages (HTTP Basic auth; the
# user name is ignored). It must be 16 characters or more: when it is empty
# or shorter, /admin answers 404. The real value is set only in Vercel
# (Production and Preview), never here or in .env.local.
ADMIN_PASSWORD=

# Optional: the private witness's folder (pnpm data:witness, run by hand on
# Jalel's PC; decision P48). Default: %USERPROFILE%\.kora-witness (or
# ~/.kora-witness). It must be outside the repository: the command refuses
# a folder inside it. Pages and values read from the sites stay there only.
KORA_WITNESS_DIR=
