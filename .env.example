# Copy to .env.local and fill in. Never commit real values. Leave the two
# database lines out of .env.local: local runs use the Docker database from
# .env.development, and the hosted database values live only in Vercel.

# Postgres (Neon pooled connection string in production, Docker locally)
DATABASE_URL=
# Direct (unpooled) connection, used for migrations
DATABASE_URL_UNPOOLED=

# Upstash Redis (leaderboards, rate limits). Features that need it are off
# when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: error tracking. Nothing is sent when this is empty.
SENTRY_DSN=

# Optional: PostHog, cookieless. Nothing is loaded when the key is empty.
# The key is public by design (it is sent to every browser).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional: the password for the hidden /admin pages (HTTP Basic auth; the
# user name is ignored). It must be 16 characters or more: when it is empty
# or shorter, /admin answers 404. The real value is set only in Vercel
# (Production and Preview), never here or in .env.local.
ADMIN_PASSWORD=
