{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start --port 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/ar",
        "http://localhost:3200/tn",
        "http://localhost:3200/fr",
        "http://localhost:3200/ar/chkoun",
        "http://localhost:3200/ar/sources",
        "http://localhost:3200/ar/privacy"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://localhost:3200/(ar|tn|fr|ar/sources|ar/privacy)$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "resource-summary:script:size": [
              "error",
              { "maxNumericValue": 250000 }
            ],
            "resource-summary:font:size": [
              "error",
              { "maxNumericValue": 200000 }
            ],
            "resource-summary:total:size": [
              "error",
              { "maxNumericValue": 500000 }
            ]
          }
        },
        {
          "matchingUrlPattern": "/chkoun$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "http-status-code": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "robots-txt": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "hreflang": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }],
            "resource-summary:script:size": [
              "error",
              { "maxNumericValue": 250000 }
            ],
            "resource-summary:font:size": [
              "error",
              { "maxNumericValue": 200000 }
            ],
            "resource-summary:total:size": [
              "error",
              { "maxNumericValue": 500000 }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
